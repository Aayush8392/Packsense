# Copy to .env and fill in yourself. Never commit .env. Values are never printed or pasted into chat.
# Names only; every variable is empty here.

# Databricks (use narrow, expiring tokens; admin token only for setup)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_PIPELINE_TOKEN=
DATABRICKS_ANALYST_TOKEN=

# Backblaze B2 (S3 API). The capture job uses an upload-only, bucket-scoped key.
B2_S3_ENDPOINT=
B2_BUCKET=
B2_UPLOAD_KEY_ID=
B2_UPLOAD_APPLICATION_KEY=

# Hugging Face (fine-grained token scoped to the one private archive dataset)
HF_TOKEN=
HF_ARCHIVE_REPO=

# LLM gateway
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Neon (review store)
NEON_DATABASE_URL=

# Monitoring
HEALTHCHECKS_PING_URL=
