# Copy to .env and fill in yourself. Never commit .env. Values are never printed or pasted into chat.
# Names only; every variable is empty here. Fill a field only when a module needs it.
# Scripts read this file with `--env-file .env` (or take the same names from the environment).

# Databricks (narrow, expiring tokens; the admin token is for setup scripts)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_PIPELINE_TOKEN=
DATABRICKS_ANALYST_TOKEN=
# Gold service principal (P4: OAuth M2M; also stored in the Databricks secret scope, not in jobs' parameters)
DATABRICKS_SP_CLIENT_ID=
DATABRICKS_SP_CLIENT_SECRET=
DATABRICKS_WAREHOUSE_HTTP_PATH=

# Backblaze B2 (S3 API). The capture job uses an upload-only, bucket-scoped key (a GitHub secret, not needed locally).
B2_S3_ENDPOINT=
B2_BUCKET=
B2_READ_KEY_ID=
B2_READ_APPLICATION_KEY=
# Admin key: only to change B2 infrastructure through Terraform; delete it again afterwards.
B2_ADMIN_KEY_ID=
B2_ADMIN_APPLICATION_KEY=

# Terraform state (B2 bucket tfstate-aayush) and the GitHub token Terraform uses
TF_STATE_KEY_ID=
TF_STATE_APP_KEY=
GH_TF_TOKEN=
GITHUB_ROTATION_TOKEN=

# Hugging Face (fine-grained tokens, each scoped to one repo)
HF_ARCHIVE_REPO=
HF_DUMP_REPO=
HF_ARCHIVE_TOKEN=
HF_DUMP_READ_TOKEN=

# Monitoring (a ping URL is a capability: regenerate it if it ever leaks)
HEALTHCHECKS_CAPTURE_PING_URL=
HEALTHCHECKS_FRESHNESS_PING_URL=
HEALTHCHECKS_MARKERS_PING_URL=
HEALTHCHECKS_CORE_PING_URL=
HEALTHCHECKS_ARCHIVE_PING_URL=
HEALTHCHECKS_DRIFT_PING_URL=

# LLM gateway (P8)
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Neon (review store, P8)
NEON_DATABASE_URL=
